using Gtk 4.0;
using Adw 1;

template $DmView : Gtk.Box {
  orientation: vertical;
  spacing: 12;
  margin-end: 10;
  margin-top: 10;
  margin-start: 10;
  margin-bottom: 10;

  Gtk.Stack message_list_holder {
    hexpand: true;
    vexpand: true;

      Gtk.Spinner message_list_loader {
        height-request: 48;
        width-request: 48;
        halign: center;
        valign: center;
      }

      Gtk.ScrolledWindow message_list {
        Gtk.ListView message_list_view {
          css-classes: ["transparent"];
        }
    }
  }

  Box msg_box {}
}